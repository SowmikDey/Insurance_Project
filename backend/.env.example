PROJECT_NAME=BimaGyan - AI Insurance Platform India
API_V1_STR=/api/v1

# PostgreSQL Database URLs (e.g. Neon connection pooler for runtime, direct URL for migrations)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/insurance_db?sslmode=require
DATABASE_DIRECT_URL=postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/insurance_db?sslmode=require

# Optional LLM Providers for RAG Assistant
LLM_PROVIDER=hybrid
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Uploads directory
UPLOAD_DIR=data/uploads
