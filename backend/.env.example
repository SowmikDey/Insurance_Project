PROJECT_NAME=BimaGyan - AI Insurance Platform India
API_V1_STR=/api/v1

# ── PostgreSQL Database (Neon) ────────────────────────────────────────────────
# Pooler URL for runtime / API server
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/insurance_db?sslmode=require
# Direct URL for Alembic migrations (bypasses PgBouncer)
DATABASE_DIRECT_URL=postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/insurance_db?sslmode=require

# ── LLM Inference Provider (Cloudflare Workers AI Edge Inference) ───────────
LLM_PROVIDER=bimagyan

# ── BimaGyan Fine-tuned Model (Hugging Face) ─────────────────────────────────
# After training on Kaggle, the merged model is pushed to HF Hub.
# 1. Get a token at https://huggingface.co/settings/tokens (read or write)
# 2. Enable "Inference API" for the public model on its HF model page
# 3. Set the URL to the merged (non-adapter) model repo
HF_API_TOKEN=hf_your_token_here
HF_INFERENCE_URL=https://api-inference.huggingface.co/models/your-username/bimagyan-merged
HF_MODEL_REPO=your-username/bimagyan

# ── Kaggle API (for training dataset upload & notebook retraining) ────────────
# Get credentials at https://www.kaggle.com/settings → Account → Create New Token
# Used by: backend/scripts/upload_to_kaggle.py
#          POST /api/v1/ingestion/trigger-retrain (future: auto-upload)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ── Admin API Key (protects /ingestion/upload, /trigger-retrain, etc.) ───────
ADMIN_API_KEY=change_me_to_a_strong_secret

# ── Upload Directory ──────────────────────────────────────────────────────────
UPLOAD_DIR=data/uploads
